rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Published outlooks: anyone can read (public site), only allow-listed
    // editors can create new ones. Outlooks are immutable once published —
    // "editing" a past bulletin means publishing a new one.
    match /outlooks/{outlookId} {
      allow read: if true;
      allow create: if request.auth != null
                    && exists(/databases/$(database)/documents/editors/$(request.auth.uid));
      allow update, delete: if false;
    }

    // Editor allowlist: one document per authorised UID, e.g. editors/{uid}.
    // A signed-in user may check ONLY their own document (needed for the
    // client-side "am I an editor" check) -- nobody can read anyone else's
    // or list the collection. Manage documents from the Firebase console.
    match /editors/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
